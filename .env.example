# ==============================================================================
# AiTrading - Private AI Trading Analyst & Risk Manager for Revolut
# ==============================================================================

# Database SQLite locale persistente (in Docker: file:/app/data/trading.db)
DATABASE_URL="file:./data/trading.db"

# Google Gemini API Key (per modelli gemini-2.5-flash e gemini-2.5-pro)
# Puoi anche impostarla o aggiornarla direttamente dall'interfaccia UI
GEMINI_API_KEY=""

# Credenziali Bot Telegram per notifiche e schede operative Revolut
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Fuso orario per i Cron Job automatici
TZ="Europe/Rome"

# Porta server Next.js (default: 3000)
PORT=3000
